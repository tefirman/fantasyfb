<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>fantasyfb · Week {{ week }}{% if bestball %} (Best Ball){% endif %}</title>
<style>
{{ css }}
body { margin: 0; background: var(--color-bg); }
a { color: var(--color-accent-700); }
a:hover { color: var(--color-accent-900); }
/* Phones: tighter padding, a title that fits, a team picker that can shrink,
   and 44px tap targets for the tab and filter buttons. */
@media (max-width: 600px) {
  main { padding: var(--space-6) 16px 48px !important; gap: var(--space-6) !important; }
  #team-name { font-size: 36px !important; overflow-wrap: anywhere; }
  #team-select { min-width: 0 !important; width: 100% !important; font-size: 16px !important; }
  header.nav > div:last-child, header.nav label { width: 100%; }
  #tabs { max-width: 100%; overflow-x: auto; }
  #tabs button, .btn { min-height: 44px; }
  input, select { font-size: 16px; }
}
/* Printing / Save as PDF: prints the tab on screen. Keep colors and bars,
   use landscape for the wide tables, and don't split rows or cards. */
@page { size: landscape; margin: 0.5in; }
@media print {
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .no-print { display: none !important; }
  /* "Save as PDF" stages every tab in #print-all (see printAll in report.js) */
  html.print-all #content { display: none !important; }
  html.print-all #print-all { display: flex !important; flex-direction: column; gap: var(--space-8); }
  .print-page + .print-page { break-before: page; }
  .report-root { min-height: 0 !important; }
  main { max-width: none !important; padding: 0 !important; }
  tr, .card, .panel, svg { break-inside: avoid; }
  thead { display: table-header-group; }
  h1, h2, h3 { break-after: avoid; }
  a { color: inherit; text-decoration: none; }
}
</style>
</head>
<body>
<div class="report-root" style="min-height:100vh;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body);font-variant-numeric:tabular-nums">
  <header class="nav" style="border-bottom:1px solid var(--color-divider);flex-wrap:wrap;gap:var(--space-4)">
    <div class="nav-brand" style="display:flex;align-items:baseline;gap:var(--space-3)">
      <span style="font-size:22px">fantasyfb</span>
      <span id="meta" style="font-family:var(--font-body);font-weight:400;font-size:13px;color:var(--color-neutral-700)"></span>
    </div>
    <div class="no-print" style="display:flex;align-items:center;gap:var(--space-4);flex-wrap:wrap">
    <label style="display:flex;align-items:center;gap:var(--space-2);font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-neutral-700)">
      <span>Viewing</span>
      <select id="team-select" class="input" style="width:auto;min-width:220px;text-transform:none;letter-spacing:0;font-size:14px"></select>
    </label>
    <button type="button" class="btn btn-secondary" data-action="print" title="Opens your browser's print dialog with every tab, one per page. Choose Save as PDF as the destination.">Save as PDF</button>
    </div>
  </header>

  <main style="max-width:1280px;margin:0 auto;padding:var(--space-8) var(--space-6) 64px;display:flex;flex-direction:column;gap:var(--space-8)">
    <section style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:var(--space-4)">
      <div>
        <div id="kicker" style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-accent-700)"></div>
        <h1 id="team-name" style="margin:0;font-size:52px;line-height:1"></h1>
        <div id="team-sub" style="margin-top:var(--space-2);font-size:15px;color:var(--color-neutral-700)"></div>
      </div>
      <div id="tabs" class="no-print" role="tablist"></div>
    </section>

    <div id="content" style="display:flex;flex-direction:column;gap:var(--space-8)"></div>
    <div id="print-all" style="display:none"></div>

    <footer style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:var(--space-3);font-size:12px;color:var(--color-neutral-700);border-top:1px solid var(--color-divider);padding-top:var(--space-4)">
      <span>Generated by fantasyfb · projections from nflverse, rosters from {{ platform }}{% if platform|lower == "yahoo" %}
        <a href="https://www.yahoo.com/?ilc=401" target="_blank" rel="noopener" style="display:inline-block;vertical-align:middle;margin-left:var(--space-3);line-height:0"><img src="https://poweredby.yahoo.com/poweredby_yahoo_h_purple.png" srcset="https://poweredby.yahoo.com/poweredby_yahoo_h_purple_retina.png 2x" width="134" height="20" alt="Powered by Yahoo"></a>{% endif %}</span>
      <span>WAR = wins above replacement · Matchup = opponent adjustment factor</span>
    </footer>
  </main>
</div>
<script type="application/json" id="report-data">{{ data_json }}</script>
<script>
{{ js }}
</script>
</body>
</html>
