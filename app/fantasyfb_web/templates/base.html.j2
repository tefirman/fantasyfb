<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}fantasyfb{% endblock %}</title>
<link rel="icon" type="image/png" sizes="32x32" href="/static/icon-32.png">
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/static/icon-180.png">
<meta name="theme-color" content="#1d2d3d">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="fantasyfb">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<link rel="stylesheet" href="/static/industry-styles.css">
<style>
body { margin: 0; background: var(--color-bg); font-variant-numeric: tabular-nums; }
a { color: var(--color-accent-700); }
a:hover { color: var(--color-accent-900); }
.kicker { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-accent-700); }
.muted { color: var(--color-neutral-700); }
.panel { position: relative; padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-4); }
.panel h2 { margin: 0; font-size: 26px; }
.step { font-family: var(--font-heading); font-weight: var(--font-heading-weight); color: var(--color-accent-700); margin-right: var(--space-2); }
.row { display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: flex-end; }
.row > .field { flex: 1; min-width: 160px; }
.error { color: #9b2c2c; font-size: 14px; }
.check { display: flex; gap: var(--space-3); align-items: flex-start; font-size: 14px; cursor: pointer; }
.check input { accent-color: var(--color-accent); width: 16px; height: 16px; margin: 3px 0 0; flex: none; }
.check small { display: block; color: var(--color-neutral-700); font-size: 12px; }
[hidden] { display: none !important; }
@media (max-width: 600px) {
  main { padding: var(--space-6) 16px 48px !important; }
  h1 { font-size: 40px !important; }
  .panel { padding: var(--space-4); }
  .tagline { display: none; }
  .gh { white-space: nowrap; }
  input, select { font-size: 16px !important; }
}
</style>
</head>
<body>
<div style="min-height:100vh;color:var(--color-text);font-family:var(--font-body)">
  <header class="nav" style="border-bottom:1px solid var(--color-divider)">
    <a class="nav-brand" href="/" style="font-size:22px;color:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:var(--space-2)"><img src="/static/fantasyfb_logo.png" alt="" width="19" height="29" style="display:block">fantasyfb</a>
    <span class="muted tagline" style="font-size:13px">Season simulations for Sleeper and Yahoo leagues</span>
    <a class="muted gh" href="https://github.com/tefirman/fantasyfb" target="_blank" rel="noopener" style="font-size:13px;margin-left:auto;display:inline-flex;align-items:center;gap:6px;text-decoration:none"><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" style="flex:none"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>Source on GitHub</a>
  </header>
  <main style="max-width:880px;margin:0 auto;padding:var(--space-8) var(--space-6) 64px;display:flex;flex-direction:column;gap:var(--space-8)">
    {% block main %}{% endblock %}
    <footer style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:var(--space-3);font-size:12px;color:var(--color-neutral-700);border-top:1px solid var(--color-divider);padding-top:var(--space-4)">
      <span>Projections from nflverse · rosters from Sleeper's public API or your Yahoo account</span>
      <span style="display:inline-flex;align-items:center;gap:var(--space-3);flex-wrap:wrap">Read-only. Nothing is ever written to your league.{% if yahoo_enabled %}
        <a href="https://www.yahoo.com/?ilc=401" target="_blank" rel="noopener" style="line-height:0"><img src="https://poweredby.yahoo.com/poweredby_yahoo_h_purple.png" srcset="https://poweredby.yahoo.com/poweredby_yahoo_h_purple_retina.png 2x" width="134" height="20" alt="Powered by Yahoo"></a>{% endif %}</span>
    </footer>
  </main>
</div>
{% block scripts %}{% endblock %}
</body>
</html>
