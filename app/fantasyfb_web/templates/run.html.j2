{% extends "base.html.j2" %}
{% block title %}Simulating… · fantasyfb{% endblock %}
{% block main %}
<section>
  <div class="kicker">{{ job.opts.season }} · {{ "{:,}".format(job.opts.sims) }} simulations</div>
  <h1 style="margin:0;font-size:52px;line-height:1">{{ job.opts.team }}</h1>
</section>

<div class="blueprint panel" aria-live="polite">
  <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
  {% if failed %}
  <h2>The run didn't finish</h2>
  <p class="error" style="margin:0">{{ job.error }}</p>
  <p style="margin:0"><a href="/">Back to the league picker</a></p>
  {% else %}
  <div style="display:flex;justify-content:space-between;align-items:baseline;gap:var(--space-3);flex-wrap:wrap">
    <h2 id="stage">{{ job.stage }}</h2>
    <span id="elapsed" class="muted" style="font-size:14px"></span>
  </div>
  <div style="height:6px;background:var(--color-neutral-200);position:relative;overflow:hidden">
    <div id="bar" style="position:absolute;top:0;bottom:0;left:0;width:30%;background:var(--color-accent);animation:slide 1.4s ease-in-out infinite"></div>
  </div>
  <ol id="stages" class="muted" style="margin:0;padding-left:20px;font-size:14px"></ol>
  <p class="muted" style="margin:0;font-size:13px">
    Loading projections takes about a minute. The page switches to your report when it's ready,
    and this link works for a few hours if you want to come back to it.
  </p>
  {% endif %}
</div>
<style>@keyframes slide { 0% { left: -30%; } 100% { left: 100%; } }</style>
{% endblock %}

{% block scripts %}
{% if not failed %}
<script>
(function () {
  "use strict";
  var id = {{ job.id | tojson }};
  var $ = function (i) { return document.getElementById(i); };
  function fmt(s) { s = Math.round(s); return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0"); }

  async function poll() {
    try {
      var res = await fetch("/api/runs/" + id);
      if (res.status === 404) { window.location.reload(); return; }
      if (!res.ok) throw new Error(res.status);
      var s = await res.json();
      if (s.status === "done" || s.status === "failed") { window.location.reload(); return; }
      $("stage").textContent = s.status === "queued"
        ? (s.queue_position ? s.queue_position + " run" + (s.queue_position > 1 ? "s" : "") + " ahead of yours" : "Starting…")
        : s.stage;
      $("elapsed").textContent = s.status === "running" ? fmt(s.elapsed) + " elapsed" : "";
      var done = s.stages.slice(0, -1);
      $("stages").innerHTML = "";
      done.forEach(function (t) {
        var li = document.createElement("li");
        li.textContent = t + " ✓";
        $("stages").appendChild(li);
      });
    } catch (err) { /* transient; keep polling */ }
    setTimeout(poll, 2000);
  }
  poll();
})();
</script>
{% endif %}
{% endblock %}
